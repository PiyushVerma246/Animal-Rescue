PORT=5000
MONGO_URI=mongodb://localhost:27017/anicure
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# ── AI Duplicate Detection ───────────────────────────────────────────────────
# URL of the Python CLIP embedding microservice
AI_SERVICE_URL=http://localhost:8000
# Timeout (ms) waiting for the AI service to respond
AI_TIMEOUT_MS=10000
# Composite score threshold for classifying a report as a duplicate (0.0–1.0)
DUPLICATE_SCORE_THRESHOLD=0.90
# Rate limiter window in ms (default: 900000 = 15 minutes)
RESCUE_RATE_LIMIT_WINDOW_MS=900000
# Max rescue reports per IP per window
RESCUE_RATE_LIMIT_MAX=5
